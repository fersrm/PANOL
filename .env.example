# Desarrollo local: copiar a .env y generar una SECRET_KEY propia.
SECRET_KEY=reemplazar-por-una-clave-unica
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Base de datos: mantener una sola DATABASE_URL activa.
# SQLite por defecto; las rutas relativas parten de la raiz del proyecto.
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (instalar psycopg y crear la base antes de usarlo).
# DATABASE_URL=postgres://usuario:contrasena@127.0.0.1:5432/nombre_base

# MySQL (instalar mysqlclient y crear la base antes de usarlo).
# DATABASE_URL=mysql://usuario:contrasena@127.0.0.1:3306/nombre_base
